              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response has search, count, results\", () => pm.expect(pm.response.json()).to.include.all.keys(\"search\", \"count\", \"results\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"search echoed back\", () => pm.expect(body.search).to.eql(\"select_related\"));",
                  "pm.test(\"At least one result\", () => pm.expect(body.count).to.be.above(0));",
                  "pm.test(\"count matches results length\", () => pm.expect(body.results.length).to.eql(body.count));",
                  "pm.test(\"Result shape\", () => pm.expect(body.results[0]).to.include.all.keys(\"id\", \"question\", \"answer\", \"category\"));"
                ]
