{
  "info": {
    "_postman_id": "6f1d2c3a-9b7e-4c55-8a41-2e0f5d7c9b10",
    "name": "TeamBoard API",
    "description": "Run with the Collection Runner, in order.\n\nBefore scenario 10: change one company's role to 'admin' in PGAdmin and set the admin_username / admin_password collection variables to that company's login.\n\nScenario 11 (verify QueryLog rows) is a PGAdmin check - after scenarios 6 and 7 run:\nSELECT * FROM api_querylog ORDER BY queried_at DESC;",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Assignment Scenarios (1-10)",
      "item": [
        {
          "name": "01 - Register a new company",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{client_username}}\",\n  \"password\": \"{{client_password}}\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh username each run so the collection can be re-run.",
                  "// \"role\": \"admin\" in the body must be ignored - new companies are always CLIENT.",
                  "pm.collectionVariables.set(\"client_username\", \"acmecorp_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response has username, company_name, api_key, access\", () => pm.expect(pm.response.json()).to.include.all.keys(\"username\", \"company_name\", \"api_key\", \"access\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"username echoed back\", () => pm.expect(body.username).to.eql(pm.collectionVariables.get(\"client_username\")));",
                  "pm.test(\"company_name saved\", () => pm.expect(body.company_name).to.eql(\"Acme Corp\"));",
                  "pm.test(\"api_key auto-generated\", () => pm.expect(body.api_key).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"JWT access token returned\", () => pm.expect(body.access.split(\".\")).to.have.lengthOf(3));",
                  "pm.collectionVariables.set(\"client_api_key\", body.api_key);",
                  "pm.collectionVariables.set(\"client_token\", body.access);",
                  "pm.collectionVariables.set(\"client_refresh\", body.refresh);"
                ]
              }
            }
          ]
        },
