              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response has total_queries, active_companies, top_search_terms\", () => pm.expect(pm.response.json()).to.include.all.keys(\"total_queries\", \"active_companies\", \"top_search_terms\"));",
                  "const body = pm.response.json();",
                  "pm.test(\"total_queries includes scenarios 6 and 7\", () => pm.expect(body.total_queries).to.be.at.least(2));",
                  "pm.test(\"active_companies >= 1\", () => pm.expect(body.active_companies).to.be.at.least(1));",
                  "pm.test(\"At most 5 top terms\", () => pm.expect(body.top_search_terms.length).to.be.at.most(5));",
                  "pm.test(\"Top terms shape\", () => body.top_search_terms.forEach(t => pm.expect(t).to.have.all.keys(\"search_term\", \"count\")));",
                  "pm.test(\"Top terms sorted by count desc\", () => {",
                  "    const counts = body.top_search_terms.map(t => t.count);",
                  "    pm.expect(counts).to.eql([...counts].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        }
